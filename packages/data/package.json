{
  "name": "@gachia/data",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./index.ts",
  "types": "./index.ts",
  "scripts": {
    "type-check": "tsc --noEmit",
    "validate": "tsx scripts/validate.ts",
    "generate:manifests": "node scripts/generate-manifests.mjs",

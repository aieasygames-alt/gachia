{
  "name": "@gachia/db",
  "version": "0.0.1",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "type-check": "tsc --noEmit",
    "generate": "drizzle-kit generate",
    "migrate:local": "wrangler d1 migrations apply gachia-db --local --config ../../apps/web/wrangler.jsonc",
    "migrate:remote": "wrangler d1 migrations apply gachia-db --remote --config ../../apps/web/wrangler.jsonc",
    "clean": "rm -rf dist node_modules"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260511.1",
    "drizzle-kit": "^0.31.10",
    "typescript": "^5.8.0",
    "wrangler": "^4.16.0"
  }
}

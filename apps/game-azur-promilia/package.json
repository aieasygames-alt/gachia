{
  "name": "@gachia/game-azur-promilia",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "node ../../scripts/require-game-runtime.mjs && next build",
    "build:worker": "AZUR_PROMILIA_DEPLOYMENT_MODE=production opennextjs-cloudflare build --config wrangler.jsonc --env \"\" && node ../../scripts/game-release.mjs prepare-assets --game azur-promilia --environment production",
    "preview": "AZUR_PROMILIA_DEPLOYMENT_MODE=preview opennextjs-cloudflare build --config wrangler.jsonc --env staging && node ../../scripts/game-release.mjs prepare-assets --game azur-promilia --environment staging && AZUR_PROMILIA_DEPLOYMENT_MODE=preview opennextjs-cloudflare preview --config wrangler.jsonc --env staging",
    "deploy": "node ../../scripts/game-release.mjs deploy --game azur-promilia --environment production",
    "deploy:production": "node ../../scripts/game-release.mjs deploy --game azur-promilia --environment production",
    "deploy:preview": "node ../../scripts/game-release.mjs deploy --game azur-promilia --environment staging",
    "verify:production": "node ../../scripts/azur-promilia-production-audit.mjs",
    "smoke:production": "pnpm run verify:production",
    "smoke:preview": "node scripts/smoke.mjs",
    "smoke": "pnpm run smoke:preview",
    "seo:parity": "node ../../scripts/azur-promilia-seo-parity.mjs",
    "audit:production": "node ../../scripts/azur-promilia-production-audit.mjs",
    "audit:content": "node ../../scripts/azur-promilia-content-audit.mjs",
    "verify:bundle": "node ../../scripts/game-release.mjs verify --game azur-promilia --environment production",
    "type-check": "tsc --noEmit",
    "deploy:staging": "node ../../scripts/game-release.mjs deploy --game azur-promilia --environment staging",
    "verify:preview": "node ../../scripts/game-release.mjs verify --game azur-promilia --environment staging",
    "smoke:staging": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@gachia/core": "workspace:*",
    "@gachia/data": "workspace:*",
    "@gachia/ui": "workspace:*",
    "next": "15.5.28",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261006.1",
    "@opennextjs/cloudflare": "1.20.13",
    "@types/node": "25.6.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "typescript": "^5.8.0",
    "wrangler": "4.148.0"
  }
}

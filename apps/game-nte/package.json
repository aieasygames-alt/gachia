{
  "name": "@gachia/game-nte",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "node ../../scripts/require-app-runtime.mjs && next build",
    "build:worker": "NTE_DEPLOYMENT_MODE=live opennextjs-cloudflare build --config wrangler.jsonc --env \"\" && node ../../scripts/game-release.mjs prepare-assets --game nte --environment production",
    "deploy": "node ../../scripts/production-release.mjs deploy --targets nte",
    "preview": "NTE_DEPLOYMENT_MODE=preview opennextjs-cloudflare build --config wrangler.jsonc --env staging && node ../../scripts/game-release.mjs prepare-assets --game nte --environment staging && NTE_DEPLOYMENT_MODE=preview opennextjs-cloudflare preview --config wrangler.jsonc --env staging",
    "deploy:preview": "node ../../scripts/game-release.mjs deploy --game nte --environment staging",
    "smoke": "node scripts/smoke.mjs",
    "audit:full": "node scripts/full-audit.mjs",
    "audit:content": "node scripts/content-audit.mjs",
    "audit:site": "node scripts/site-audit.mjs",
    "verify:indexing-mode": "node scripts/assert-indexing-mode.mjs",
    "verify:japanese-indexing": "node scripts/assert-japanese-indexing.mjs",
    "seo:parity": "node ../../scripts/nte-seo-parity.mjs",
    "verify:bundle": "node ../../scripts/game-release.mjs verify --game nte --environment production",
    "type-check": "tsc --noEmit",
    "deploy:production": "node ../../scripts/production-release.mjs deploy --targets nte",
    "deploy:staging": "node ../../scripts/game-release.mjs deploy --game nte --environment staging",
    "verify:preview": "node ../../scripts/game-release.mjs verify --game nte --environment staging",
    "release:plan": "node ../../scripts/production-release.mjs plan --targets nte"
  },
  "dependencies": {
    "@gachia/core": "workspace:*",
    "@gachia/data": "workspace:*",
    "@gachia/ui": "workspace:*",
    "next": "15.5.28",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261006.1",
    "@opennextjs/cloudflare": "1.20.13",
    "@types/node": "25.6.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "typescript": "^5.8.0",
    "wrangler": "4.148.0"
  }
}

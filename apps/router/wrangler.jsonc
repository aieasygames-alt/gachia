{
  "name": "gachia-router",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-08",
  "workers_dev": true,
  "vars": {
    "AZUR_PROMILIA_ENABLED": "true",
    "AZUR_PROMILIA_CANARY_COOKIE": "",
    "GENSHIN_ENABLED": "true",
    "GENSHIN_CANARY_COOKIE": ""
  },
  "services": [
    {
      "binding": "MAIN_SITE",
      "service": "gachia"
    },
    {
      "binding": "NTE_SITE",
      "service": "gachia-game-nte"
    },
    {
      "binding": "AZUR_PROMILIA_SITE",
      "service": "gachia-game-azur-promilia"
    },
    {
      "binding": "GENSHIN_SITE",
      "service": "gachia-game-genshin"
    }
  ],
  "env": {
    "staging": {
      "name": "gachia-router-staging",
		"workers_dev": false,
      "vars": {
        "AZUR_PROMILIA_ENABLED": "false",
        "AZUR_PROMILIA_CANARY_COOKIE": "enabled",
        "GENSHIN_ENABLED": "false",
        "GENSHIN_CANARY_COOKIE": "enabled",
        "PREVIEW_MODE": "true"
      },
      "services": [
        {
          "binding": "MAIN_SITE",
          "service": "gachia-staging"
        },
        {
          "binding": "AZUR_PROMILIA_SITE",
          "service": "gachia-game-azur-promilia"
        },
        {
          "binding": "GENSHIN_SITE",
          "service": "gachia-game-genshin"
        }
      ]
    }
  }
}

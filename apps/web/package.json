{
  "name": "@gachia/web",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack --port 3000",
    "build": "next build",
    "preview": "opennextjs-cloudflare build && NODE_OPTIONS=--disable-warning=DEP0190 opennextjs-cloudflare preview --config wrangler.jsonc --env \"\"",
    "preview:staging": "opennextjs-cloudflare build && NODE_OPTIONS=--disable-warning=DEP0190 opennextjs-cloudflare preview --config wrangler.jsonc --env staging",
    "deploy": "opennextjs-cloudflare build && NODE_OPTIONS=--disable-warning=DEP0190 opennextjs-cloudflare deploy --config wrangler.jsonc --env \"\"",
    "deploy:staging": "opennextjs-cloudflare build && NODE_OPTIONS=--disable-warning=DEP0190 opennextjs-cloudflare deploy --config wrangler.jsonc --env staging",
    "upload": "opennextjs-cloudflare build && NODE_OPTIONS=--disable-warning=DEP0190 opennextjs-cloudflare upload --config wrangler.jsonc --env \"\"",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "type-check": "tsc --noEmit",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "clean": "rm -rf .next .open-next node_modules"
  },
  "dependencies": {
    "@gachia/core": "workspace:*",
    "@gachia/data": "workspace:*",
    "@gachia/db": "workspace:*",
    "@next/third-parties": "^16.2.6",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tanstack/react-query": "^5.75.0",
    "better-auth": "^1.6.13",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.510.0",
    "next": "^15.5.18",
    "next-intl": "^4.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-leaflet": "^5.0.0",
    "react-leaflet-cluster": "^4.1.3",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.3.0",
    "zod": "^3.25.76",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260511.1",
    "@eslint/eslintrc": "^3.3.6",
    "@next/bundle-analyzer": "^16.2.6",
    "@opennextjs/cloudflare": "^1.19.6",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/leaflet": "^1.9.21",
    "@types/node": "25.6.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "15.5.18",
    "postcss": "^8.5.10",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.8.0",
    "vite": "8.0.16",
    "vitest": "^4.1.10",
    "wrangler": "^4.16.0"
  }
}

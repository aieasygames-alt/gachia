{
  "name": "gachia-payload-cms",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.23.5 || ^24.22.3 || >=26.13.1"
  },
  "scripts": {
    "dev": "next dev --webpack --hostname 127.0.0.1 --port 4320",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1 --port 4320",
    "setup": "node scripts/setup.mjs",
    "seed:starrail": "node --env-file=.env --import tsx scripts/seed-starrail.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "type-check": "tsc --noEmit",
    "publish:starrail": "node --env-file=.env --import tsx scripts/publish-starrail.ts"
  },
  "dependencies": {
    "@payloadcms/db-sqlite": "3.94.1",
    "@payloadcms/next": "3.94.1",
    "graphql": "16.11.0",
    "next": "16.4.5",
    "payload": "3.94.1",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tsx": "^4.23.0",
    "typescript": "^5.9.3"
  }
}

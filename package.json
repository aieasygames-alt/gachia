{
  "name": "gachia",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "type-check": "turbo type-check",
    "test": "turbo test",
    "clean": "turbo clean",
    "indexnow:new-pages": "node scripts/indexnow-submit-new-pages.mjs",
    "indexnow:seo-updates": "node scripts/indexnow-submit-seo-updates.mjs",
    "gsc:report": "node scripts/analyze-gsc-export.mjs",
    "validate:game-deployments": "node scripts/validate-game-deployment.mjs",
    "generate:router-config": "node scripts/generate-router-game-config.mjs",
    "genshin:seo-baseline": "node scripts/genshin-seo-baseline.mjs",
    "scaffold:game": "node scripts/scaffold-game.mjs",
    "audit:seo-contract": "node scripts/seo-contract-audit.mjs",
    "content:freshness": "NODE_OPTIONS=--disable-warning=MODULE_TYPELESS_PACKAGE_JSON node scripts/content-freshness-audit.mjs",
    "content:freshness:md": "NODE_OPTIONS=--disable-warning=MODULE_TYPELESS_PACKAGE_JSON node scripts/content-freshness-audit.mjs --markdown",
    "content:freshness:report": "NODE_OPTIONS=--disable-warning=MODULE_TYPELESS_PACKAGE_JSON node scripts/content-freshness-audit.mjs --markdown --output plans/content-freshness-latest.md",
    "test:browser": "playwright test",
    "audit:production": "node scripts/production-site-audit.mjs",
    "release:game": "node scripts/game-release.mjs",
    "test:release": "node --test scripts/game-release.test.mjs scripts/game-runtime.test.mjs scripts/runtime-rollout-smoke.test.mjs scripts/game-staging-acceptance.test.mjs scripts/web-release-policy.test.mjs scripts/production-site-audit.test.mjs scripts/retain-web-assets.test.mjs && python3 -B scripts/extract-previous-web-assets.test.py"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "turbo": "^2.5.0",
    "typescript": "^5.8.0"
  },
  "packageManager": "pnpm@10.10.0",
  "pnpm": {
    "patchedDependencies": {
      "next@15.5.28": "patches/next-15.5.28-deferred-initial.patch"
    },
    "onlyBuiltDependencies": [
      "@swc/core",
      "esbuild",
      "sharp",
      "workerd",
      "@parcel/watcher"
    ],
    "overrides": {
      "kysely": "0.28.17",
      "vite": "8.0.16"
    }
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
